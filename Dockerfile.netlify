FROM node:22-alpine AS builder
RUN apk add --no-cache zip
WORKDIR /app
COPY umeed-production /app
RUN npm install --no-audit --no-fund
RUN npm run prepare:web
RUN node --check js/app-state.js || true
RUN for f in js/*.js js/controllers/*.js; do cp "$f" /tmp/check.mjs && node --check /tmp/check.mjs; done
RUN cp _redirects _headers netlify.toml web/
RUN mkdir -p /artifacts && cd web && zip -qr /artifacts/UMEED-Student-Finance-v3.2.0-Netlify.zip .
RUN sha256sum /artifacts/UMEED-Student-Finance-v3.2.0-Netlify.zip > /artifacts/UMEED-Student-Finance-v3.2.0-Netlify-SHA256.txt

FROM python:3.12-alpine
WORKDIR /artifacts
COPY --from=builder /artifacts /artifacts
EXPOSE 8080
CMD ["sh","-c","python3 -m http.server ${PORT:-8080} --directory /artifacts --bind 0.0.0.0"]