FROM eclipse-temurin:21-jdk-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH
ENV CSC_IDENTITY_AUTO_DISCOVERY=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip python3 gnupg zip p7zip-full wine64 \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-tools \
 && curl -fsSL -o /tmp/android-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip \
 && unzip -q /tmp/android-tools.zip -d /tmp/android-tools \
 && mv /tmp/android-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
 && rm -rf /tmp/android-tools /tmp/android-tools.zip \
 && yes | sdkmanager --licenses >/dev/null || true

RUN sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0"

WORKDIR /app
COPY umeed-production /app

RUN npm install --no-audit --no-fund
RUN npm run prepare:web

RUN node --check main.js \
 && node --check preload.js \
 && node --check scripts/prepare-web.mjs \
 && for f in js/*.js js/controllers/*.js; do cp "$f" /tmp/qa-check.mjs && node --check /tmp/qa-check.mjs; done

RUN npx cap add android \
 && npx cap sync android \
 && chmod +x android/gradlew \
 && cd android \
 && ./gradlew assembleDebug --no-daemon

RUN npx electron-builder --win --x64 --dir --publish never \
 && test -f "dist/win-unpacked/UMEED Fee Management.exe"

RUN mkdir -p /artifacts \
 && cp -r web/* /artifacts/ \
 && cp android/app/build/outputs/apk/debug/app-debug.apk /artifacts/UMEED-Fee-Management-v3.0.0-Android.apk \
 && cd dist \
 && zip -qr /artifacts/UMEED-Fee-Management-v3.0.0-Windows-x64.zip win-unpacked

RUN zip -qr /artifacts/UMEED-Fee-Management-v3.0.0-Source.zip . \
 -x "node_modules/*" "android/*" "web/*" "dist/*" \
 && sha256sum /artifacts/UMEED-Fee-Management-v3.0.0-Android.apk \
                 /artifacts/UMEED-Fee-Management-v3.0.0-Windows-x64.zip \
                 /artifacts/UMEED-Fee-Management-v3.0.0-Source.zip \
                 > /artifacts/UMEED-Fee-Management-v3.0.0-SHA256.txt

EXPOSE 8080
CMD ["sh","-c","python3 -m http.server ${PORT:-8080} --directory /artifacts --bind 0.0.0.0"]